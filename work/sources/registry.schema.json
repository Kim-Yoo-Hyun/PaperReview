{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperreview.local/schema/registry-1.0.json",
  "title": "PaperReview paper manifest",
  "description": "Schema for the JSON-list registry. Legacy flat fields remain allowed for compatibility; structured fields are the canonical extension.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/paper"
  },
  "$defs": {
    "urlSource": {
      "type": ["object", "null"],
      "required": ["url", "kind"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "scope": {"enum": ["paper_specific", "venue_index", "project_landing", "publisher_landing"]},
        "verified_on": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "paper": {
      "type": "object",
      "required": [
        "paper_id",
        "title",
        "year",
        "venue",
        "category",
        "tags",
        "folder",
        "page",
        "primary_track",
        "publication",
        "identifiers",
        "sources",
        "artifacts",
        "curation",
        "provenance",
        "relations"
      ],
      "properties": {
        "paper_id": {"type": "string", "pattern": "^pr-[0-9]{4,}$"},
        "title": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "venue": {"type": "string", "minLength": 1},
        "venue_as_recorded": {"type": "string"},
        "venue_canonical": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "folder": {"type": "string", "minLength": 1},
        "page": {"type": "string", "minLength": 1},
        "pdf": {"type": "string"},
        "project": {"type": "string"},
        "primary_track": {
          "type": ["string", "null"],
          "enum": [
            null,
            "Planning and control",
            "RL, IL, offline learning, and robot data",
            "Manipulation, contact, tactile, and dexterity",
            "VLA and generalist robot policies",
            "World models, safety, uncertainty, and recovery",
            "Locomotion, whole-body, mobile manipulation, and humanoids",
            "Robotics-enabling 3D perception"
          ]
        },
        "paper_type": {
          "type": "string",
          "enum": ["method", "system", "benchmark_or_dataset", "theory_or_foundation"]
        },
        "publication": {
          "type": "object",
          "required": ["venue", "year", "venue_year", "kind", "status", "presentation"],
          "properties": {
            "venue_id": {"type": "string", "minLength": 1},
            "venue": {"type": "string", "minLength": 1},
            "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
            "venue_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
            "kind": {"enum": ["conference", "journal", "workshop", "preprint", "technical_report", "other"]},
            "status": {"enum": ["peer_reviewed", "preprint", "technical_report", "unverified"]},
            "presentation": {"enum": ["unknown", "poster", "oral", "spotlight", "regular"]}
          },
          "additionalProperties": false
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "sources": {
          "type": "object",
          "required": ["primary", "preprint", "paper_pdf", "project", "code"],
          "properties": {
            "primary": {"$ref": "#/$defs/urlSource"},
            "preprint": {"$ref": "#/$defs/urlSource"},
            "paper_pdf": {"$ref": "#/$defs/urlSource"},
            "project": {"$ref": "#/$defs/urlSource"},
            "code": {"$ref": "#/$defs/urlSource"}
          },
          "additionalProperties": true
        },
        "artifacts": {
          "type": "object",
          "required": ["code_status", "data_status", "local_pdf_cache"],
          "properties": {
            "code_status": {"enum": ["released", "project_only", "not_released", "not_identified"]},
            "data_status": {"enum": ["released", "not_released", "not_identified", "not_recorded", "not_applicable"]},
            "local_pdf_cache": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "evaluation_profile": {
          "type": "object",
          "required": ["profile_version", "status", "type", "settings", "protocol", "source_note", "reviewed_on", "basis"],
          "properties": {
            "profile_version": {"type": "string", "minLength": 1},
            "status": {"enum": ["structured_note_cues", "not_recorded"]},
            "type": {"type": "string", "minLength": 1},
            "settings": {
              "type": "array",
              "items": {"enum": ["real_robot", "simulation", "benchmark_or_dataset", "source_reported", "scope_unresolved", "not_recorded"]},
              "uniqueItems": true
            },
            "protocol": {
              "type": "object",
              "required": ["dataset_or_benchmark", "metrics", "baselines", "ablations", "split_or_generalization", "trials_or_seeds", "statistics", "failure_cases"],
              "properties": {
                "dataset_or_benchmark": {"enum": ["reported", "not_reported", "not_recorded"]},
                "metrics": {"enum": ["reported", "not_reported", "not_recorded"]},
                "baselines": {"enum": ["reported", "not_reported", "not_recorded"]},
                "ablations": {"enum": ["reported", "not_reported", "not_recorded"]},
                "split_or_generalization": {"enum": ["reported", "not_reported", "not_recorded"]},
                "trials_or_seeds": {"enum": ["reported", "not_reported", "not_recorded"]},
                "statistics": {"enum": ["reported", "not_reported", "not_recorded"]},
                "failure_cases": {"enum": ["reported", "not_reported", "not_recorded"]}
              },
              "additionalProperties": false
            },
            "trial_evidence": {"type": "array", "items": {"type": "object"}},
            "benchmark_cues": {"type": "array", "items": {"type": "object"}},
            "metric_cues": {"type": "array", "items": {"type": "object"}},
            "source_note": {"type": ["string", "null"]},
            "reviewed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "basis": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "reproducibility": {
          "type": "object",
          "required": ["profile_version", "status", "code", "data", "checkpoint", "configuration", "environment", "run_conditions", "reviewed_on", "source_note", "basis"],
          "properties": {
            "profile_version": {"type": "string", "minLength": 1},
            "status": {"enum": ["metadata_audited", "not_recorded"]},
            "code": {"type": "object"},
            "data": {"type": "object"},
            "checkpoint": {"type": "object"},
            "configuration": {"type": "object"},
            "environment": {"type": "object"},
            "run_conditions": {"type": "object"},
            "reviewed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "source_note": {"type": ["string", "null"]},
            "basis": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "lineage_profile": {
          "type": "object",
          "required": ["profile_version", "status", "outgoing_paper_ids", "incoming_paper_ids", "queue_adjacency_paper_ids", "legacy_summary_candidate_paper_ids", "legacy_summary_present", "audited_on", "audit_scope", "basis"],
          "properties": {
            "profile_version": {"type": "string", "minLength": 1},
            "status": {"enum": ["curated_edges", "candidate_only", "no_curated_edge_recorded"]},
            "outgoing_paper_ids": {"type": "array", "items": {"type": "string", "pattern": "^pr-[0-9]{4,}$"}, "uniqueItems": true},
            "incoming_paper_ids": {"type": "array", "items": {"type": "string", "pattern": "^pr-[0-9]{4,}$"}, "uniqueItems": true},
            "queue_adjacency_paper_ids": {"type": "array", "items": {"type": "string", "pattern": "^pr-[0-9]{4,}$"}, "uniqueItems": true},
            "legacy_summary_candidate_paper_ids": {"type": "array", "items": {"type": "string", "pattern": "^pr-[0-9]{4,}$"}, "uniqueItems": true},
            "legacy_summary_present": {"type": "boolean"},
            "audited_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "audit_scope": {"const": "all_registry"},
            "basis": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "curation": {
          "type": "object",
          "required": ["admission_reason", "rationale_status"],
          "properties": {
            "admission_reason": {"type": ["string", "null"]},
            "rationale_status": {"enum": ["recorded", "pending"]},
            "tier_reason": {"type": ["string", "null"]},
            "scope_status": {"enum": ["active", "adjacent", "archive"]},
            "roles": {
              "type": "array",
              "items": {"enum": ["foundation", "method", "system", "benchmark_or_dataset"]},
              "uniqueItems": true
            },
            "role_basis": {"type": "string"}
          },
          "additionalProperties": true
        },
        "facets": {
          "type": "object",
          "properties": {
            "embodiment": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "modality": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "learning": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "control_level": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "setting": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "interaction": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "facet_provenance": {"type": "string"},
        "provenance": {
          "type": "object",
          "required": ["metadata_source_kind", "content_evidence", "source_audit_status", "metadata_checked_on", "schema_version", "schema_migrated_on"],
          "properties": {
            "metadata_source_kind": {"type": "string", "minLength": 1},
            "content_evidence": {"enum": ["CURATION_ONLY", "ABSTRACT_CHECKED", "FULL_TEXT_CHECKED", "EXPERIMENT_CHECKED"]},
            "source_audit_status": {"enum": ["recorded", "not_recorded"]},
            "metadata_checked_on": {"type": ["string", "null"]},
            "schema_version": {"const": "1.0"},
            "schema_migrated_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          },
          "additionalProperties": true
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "paper_id"],
            "properties": {
              "type": {"enum": ["version_of", "same_work_as", "extends", "replicates", "baseline_for", "uses_dataset", "evaluates_on", "builds_on", "supersedes"]},
              "paper_id": {"type": "string", "pattern": "^pr-[0-9]{4,}$"},
              "confidence": {"enum": ["manual", "verified", "inferred"]},
              "status": {"enum": ["curated", "imported", "unverified"]},
              "basis": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "evidence_scope": {"enum": ["paper_body", "official_abstract", "official_project", "title_lineage", "registry_identity", "citation_reference", "official_source"]},
              "reviewed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "managed_by": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
